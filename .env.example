SERVICE_NAME=ghostbusters
STATIC_DIR=static
DATABASE_URL=postgresql://ghostbusters:ghostbusters@localhost:15432/ghostbusters
REDIS_URL=redis://localhost:6379/0
DEMO_MODE_ENABLED=false
PRICING_PROVIDER=unavailable
AUTH_REQUIRED=false
SESSION_COOKIE_SECURE=false
ALLOW_INSECURE_HTTP_DEMO=false
SESSION_TTL_SECONDS=28800
AUTH_PERSISTENCE_PATH=.runtime/auth_store.json
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ALLOWED_REGIONS=us-east-1
AWS_CLOUDWATCH_LOOKBACK_DAYS=14
AWS_INTEGRATION_CONFIG_PATH=.runtime/aws_integrations.json
AWS_ONBOARDING_TRUSTED_PRINCIPAL_ARN=
AWS_ONBOARDING_ROLE_NAME=GhostBustersReadOnlyRole
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_REQUEST_TIMEOUT_SECONDS=10
JIRA_INTEGRATION_CONFIG_PATH=.runtime/jira_integrations.json
GITHUB_INTEGRATION_CONFIG_PATH=.runtime/github_integrations.json
AUTO_CREATE_SCHEMA=true
CONFTEST_ENABLED=false
CONFTEST_EXECUTABLE=conftest
CONFTEST_POLICY_DIR=policies
CONFTEST_TIMEOUT_SECONDS=5
MINIMUM_POLICY_CONFIDENCE=0.70
EXTERNAL_RETRY_ENABLED=true
EXTERNAL_RETRY_MAX_ATTEMPTS=3
EXTERNAL_RETRY_INITIAL_DELAY_SECONDS=0.25
EXTERNAL_RETRY_MULTIPLIER=2
EXTERNAL_RETRY_MAX_DELAY_SECONDS=2
EXTERNAL_RETRY_JITTER_SECONDS=0.10
EXTERNAL_CALL_TIMEOUT_SECONDS=5
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_API_VERSION=v1
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_RETRIES=2
GEMINI_ASSISTED_PLANNING_ENABLED=false
GEMINI_ASSISTANT_ENABLED=false
GEMINI_MAX_PLANNING_STEPS=6
GEMINI_TEMPERATURE=0.1
AI_DETERMINISTIC_FALLBACK_ENABLED=true
CLOUD_HUNT_ENABLED=true
CLOUD_HUNT_CANDIDATE_THRESHOLD=0.45
CLOUD_HUNT_HIGH_CONFIDENCE_THRESHOLD=0.75
CLOUD_HUNT_RESOURCE_AGE_DAYS=60
CLOUD_HUNT_ACTIVITY_LOOKBACK_DAYS=30
CLOUD_HUNT_UTILIZATION_LOOKBACK_DAYS=14
CLOUD_HUNT_LOW_CPU_THRESHOLD=10
CLOUD_HUNT_SCHEDULE_ENABLED=true
CLOUD_HUNT_SCHEDULE_CONFIG_PATH=.runtime/cloud_hunt_schedules.json
CLOUD_HUNT_SCHEDULE_INTERVAL_SECONDS=60
CLOUD_HUNT_SCHEDULE_RETRY_ATTEMPTS=2
GITHUB_INTEGRATION_ENABLED=false
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=10
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_NAME=
GITHUB_APP_CALLBACK_URL=http://127.0.0.1:8000/api/integrations/github/callback
GITHUB_APP_STATE_TTL_SECONDS=600
GITHUB_APP_INSTALLATION_TOKEN_TTL_SECONDS=300
GITHUB_DEVELOPMENT_TOKEN_FALLBACK=true
GITHUB_DEMO_REPOSITORY=
GITHUB_REMEDIATION_BRANCH_PREFIX=ghostbusters/remediation
GITHUB_CREATE_REAL_PR=false
TERRAFORM_CLI_ENABLED=false
TERRAFORM_BINARY=terraform
TERRAFORM_TIMEOUT_SECONDS=60
TERRAFORM_WORK_ROOT=.runtime/terraform
TERRAFORM_ALLOW_INIT=false
TERRAFORM_ALLOW_NETWORK=false
AWS_PROFILE=
AWS_REGION=us-east-1
AWS_ALLOWED_REGIONS=us-east-1
AWS_CLOUDWATCH_LOOKBACK_DAYS=14
AWS_INTEGRATION_CONFIG_PATH=.runtime/aws_integrations.json
AWS_ONBOARDING_TRUSTED_PRINCIPAL_ARN=
AWS_ONBOARDING_ROLE_NAME=GhostBustersReadOnlyRole
